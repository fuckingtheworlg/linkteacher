# UniClass 生产环境变量模板
# 部署时拷贝到 server/.env 并填充真实值

# ===== 数据库 =====
# 注意：MySQL 用户密码请用强密码，并 URL-encode 特殊字符
DATABASE_URL="mysql://uniclass:CHANGE_ME_STRONG_PASSWORD@localhost:3306/uniclass"

# ===== 服务端口 =====
PORT=3000

# ===== 跨域来源 =====
# 多个用逗号分隔；生产把开发端口去掉
CORS_ORIGINS="https://your-domain.com"

# ===== JWT =====
# 用 openssl rand -hex 32 生成 32 字节随机字符串
JWT_SECRET="CHANGE_ME_USE_OPENSSL_RAND_HEX_32"
JWT_EXPIRES_IN="7d"

# ===== 微信小程序 =====
# AppID 是公开值，已写入；AppSecret 仅本地填写，绝不提交到 git
WX_APPID="wx6ed01a56fff50469"
WX_SECRET="CHANGE_ME_FILL_FROM_MP_PLATFORM_DO_NOT_COMMIT"

# ===== 上传文件公网域名 =====
# 必须是公网可访问的 HTTPS 地址，否则小程序无法显示头像 / 校徽
UPLOAD_BASE_URL="https://your-domain.com/uploads"

# ===== Node 环境 =====
NODE_ENV=production
