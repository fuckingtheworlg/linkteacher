/* =========================================================================
   LinkTeacher 极简设计体系
   - 极致简洁：黑/白/灰三色 + 一个深色作强调，无花哨配色
   - 风格统一：跨页面共用 .card / .btn-primary / .btn-secondary / .empty 等工具类
   ========================================================================= */

page {
  background: #f5f7fa;
  color: #1f2937;
  font-size: 28rpx;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-tap-highlight-color: transparent;
}

/* ======================== 排版 ======================== */
.text-h1 { font-size: 40rpx; font-weight: 700; color: #1f2937; line-height: 1.4; }
.text-h2 { font-size: 32rpx; font-weight: 700; color: #1f2937; line-height: 1.4; }
.text-h3 { font-size: 30rpx; font-weight: 600; color: #1f2937; line-height: 1.4; }
.text-body { font-size: 28rpx; color: #1f2937; line-height: 1.6; }
.text-sub { font-size: 26rpx; color: #6b7280; line-height: 1.6; }
.text-muted { color: #9ca3af; }
.text-sm { font-size: 24rpx; }
.text-xs { font-size: 22rpx; }

.text-danger { color: #dc2626; }
.text-success { color: #16a34a; }

/* ======================== 布局 ======================== */
.container { padding: 24rpx; }
.section { padding: 24rpx 32rpx; }
.section-title {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 600;
  margin: 24rpx 8rpx 12rpx;
}

.flex-row { display: flex; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }
.gap-1 { gap: 8rpx; }
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }

/* ======================== 卡片 ======================== */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-tight { padding: 20rpx; }

.divider {
  height: 2rpx;
  background: #f3f4f6;
  margin: 16rpx 0;
}

/* ======================== Tag / Pill ======================== */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  background: #1f2937;
  color: #fff;
  line-height: 1.6;
}
.tag-light {
  background: #f3f4f6;
  color: #4b5563;
}
.tag-outline {
  background: transparent;
  color: #1f2937;
  border: 2rpx solid #d1d5db;
}

/* ======================== 按钮 ======================== */
.btn-primary,
.btn-secondary,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  padding: 0 32rpx;
}
.btn-primary {
  background: #1f2937;
  color: #fff;
}
.btn-primary[disabled],
.btn-primary.disabled {
  background: #9ca3af;
  color: #fff;
}
.btn-secondary {
  background: #fff;
  color: #1f2937;
  border: 2rpx solid #1f2937;
}
.btn-ghost {
  background: #f3f4f6;
  color: #4b5563;
}
.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
}

/* 重置原生 button 样式（用于 open-type=contact/share 等） */
button.btn-primary::after,
button.btn-secondary::after,
button.btn-ghost::after { border: none; }
button.btn-primary,
button.btn-secondary,
button.btn-ghost { line-height: 88rpx; }

/* ======================== 头像占位 ======================== */
.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e5e7eb;
  color: #6b7280;
  font-weight: 700;
  text-transform: uppercase;
}

/* ======================== 空状态 ======================== */
.empty-state {
  padding: 120rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #9ca3af;
  margin-bottom: 24rpx;
}
.empty-title { font-size: 30rpx; font-weight: 600; color: #4b5563; margin-bottom: 8rpx; }
.empty-sub { font-size: 26rpx; color: #9ca3af; line-height: 1.6; max-width: 480rpx; }

/* ======================== 骨架屏 ======================== */
@keyframes skeleton-shimmer {
  0%   { background-position: -200rpx 0; }
  100% { background-position: 400rpx 0; }
}
.skeleton {
  background: linear-gradient(90deg, #f3f4f6 0%, #e5e7eb 50%, #f3f4f6 100%);
  background-size: 400rpx 100%;
  animation: skeleton-shimmer 1.4s infinite;
  border-radius: 8rpx;
}
.skeleton-line { height: 24rpx; margin-bottom: 12rpx; }
.skeleton-line-sm { height: 20rpx; }
.skeleton-block { height: 160rpx; }
.skeleton-circle { border-radius: 50%; }

/* ======================== 安全区 ======================== */
.safe-area-bottom { padding-bottom: env(safe-area-inset-bottom); }
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}
