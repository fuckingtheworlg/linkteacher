.page { padding: 32rpx 24rpx; min-height: 100vh; background: #f5f7fa; }
.hero { text-align: center; padding: 32rpx 0 16rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; color: #1f2937; }
.hero-sub { color: #6b7280; font-size: 26rpx; margin-top: 12rpx; line-height: 1.6; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.card-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
}
.num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #1f2937;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  line-height: 48rpx;
  flex-shrink: 0;
}
.row-text { color: #1f2937; font-size: 28rpx; line-height: 1.6; flex: 1; }

.primary-btn {
  width: 100%;
  background: #1f2937;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 16rpx;
}
.primary-btn::after { border: none; }

.secondary-btn {
  width: 100%;
  background: #fff;
  color: #1f2937;
  border: 2rpx solid #1f2937;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 16rpx;
}
.secondary-btn::after { border: none; }
