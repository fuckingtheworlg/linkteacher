.page {
  padding: 20rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.card { margin-bottom: 20rpx; }

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar-wrap { width: 120rpx; height: 120rpx; flex-shrink: 0; }
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #e5e7eb;
}
.avatar.avatar-placeholder { font-size: 48rpx; }

.user-info { flex: 1; min-width: 0; }
.nick { font-size: 32rpx; font-weight: 700; color: #1f2937; }
.role-row { margin-top: 10rpx; }
.role-tag {
  display: inline-block;
  background: #1f2937;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}
.role-tag-light { background: #f3f4f6; color: #6b7280; }
.edit-link { color: #6b7280; font-size: 26rpx; }

/* 关于我们卡 */
.about-card { display: flex; align-items: center; justify-content: space-between; }
.about-left { flex: 1; min-width: 0; }
.about-arrow { color: #9ca3af; font-size: 40rpx; }

/* 统计 */
.stat-row { display: flex; align-items: stretch; padding: 24rpx 0; }
.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stat-num { font-size: 40rpx; font-weight: 700; color: #1f2937; }
.stat-divider { width: 2rpx; background: #f3f4f6; }

/* 宫格 */
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 32rpx;
  padding: 32rpx 8rpx;
}
.grid-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.grid-icon {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid #1f2937;
  border-radius: 12rpx;
  background: transparent;
}
.grid-label { font-size: 24rpx; color: #4b5563; }

/* 驳回提醒 */
.reject {
  background: #fef2f2;
  border-left: 6rpx solid #dc2626;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.reject-title { display: block; color: #b91c1c; font-weight: 600; margin-bottom: 6rpx; font-size: 26rpx; }
.reject-content { color: #7f1d1d; font-size: 24rpx; line-height: 1.5; }

/* 公众号 */
.oa-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.oa-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #1f2937;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.oa-info { flex: 1; min-width: 0; }
.oa-btn {
  background: #1f2937;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
}

.version { text-align: center; margin-top: 32rpx; }
