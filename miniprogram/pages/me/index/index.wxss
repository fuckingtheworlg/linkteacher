.page { padding: 24rpx; background: #f5f7fa; min-height: 100vh; }

.user-card {
  background: #1f2937;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: #fff;
}
.avatar { width: 120rpx; height: 120rpx; border-radius: 60rpx; background: #374151; }
.info { flex: 1; }
.nick { font-size: 32rpx; font-weight: 700; }
.role-tag {
  display: inline-block;
  background: #fbbf24;
  color: #1f2937;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-top: 12rpx;
  font-weight: 600;
}
.role-tag.student { background: #6b7280; color: #fff; }

.reject {
  margin-top: 20rpx;
  background: #fef2f2;
  border-left: 6rpx solid #ef4444;
  padding: 20rpx;
  border-radius: 8rpx;
}
.reject-title { display: block; color: #b91c1c; font-weight: 600; margin-bottom: 6rpx; }
.reject-content { color: #7f1d1d; font-size: 26rpx; line-height: 1.5; }

.menu {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
  background: transparent;
  text-align: left;
  font-size: 28rpx;
  color: #1f2937;
}
.menu-item:last-child { border-bottom: none; }
.menu-item.contact { display: flex; }
.menu-item.contact::after { border: none; }
.arrow { margin-left: auto; color: #9ca3af; font-size: 32rpx; }
