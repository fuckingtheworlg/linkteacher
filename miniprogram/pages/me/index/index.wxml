<view class="page">
  <view class="user-card">
    <image class="avatar" src="{{ (user && user.avatarUrl) || '/assets/avatar-default.png' }}" mode="aspectFill" />
    <view class="info">
      <view class="nick">{{ (user && user.nickname) || ('用户-' + ((user && user.id) || '')) }}</view>
      <view class="role-tag" wx:if="{{ teacher }}">导师 · {{ statusText }}</view>
      <view class="role-tag student" wx:else>学生</view>
    </view>
  </view>

  <view class="reject" wx:if="{{ teacher && teacher.status === 'REJECTED' && rejectReason }}">
    <text class="reject-title">驳回原因</text>
    <text class="reject-content">{{ rejectReason }}</text>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goEditProfile" wx:if="{{ teacher }}">
      <text>📝</text><text>编辑导师资料</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="becomeTeacher" wx:else>
      <text>🎓</text><text>成为导师</text>
      <text class="arrow">›</text>
    </view>
    <button class="menu-item contact" open-type="contact" session-from="me_contact_us">
      <text>💬</text><text>联系客服</text>
      <text class="arrow">›</text>
    </button>
    <view class="menu-item" bindtap="onLogout">
      <text>🚪</text><text>退出登录</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
