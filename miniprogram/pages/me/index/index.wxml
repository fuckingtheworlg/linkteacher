<view class="page">
  <!-- 用户卡片 -->
  <view class="card user-card">
    <view class="avatar-wrap" bindtap="onPickAvatar">
      <image
        wx:if="{{ user && user.avatarUrl }}"
        class="avatar"
        src="{{ user.avatarUrl }}"
        mode="aspectFill"
      />
      <view wx:else class="avatar avatar-placeholder">+</view>
      <view class="avatar-edit-badge">✎</view>
    </view>
    <view class="user-info">
      <view class="nick">{{ (user && user.nickname) || ('user-' + ((user && user.id) || '----')) }}</view>
      <view class="role-row">
        <text class="role-tag" wx:if="{{ teacher }}">导师 · {{ statusText }}</text>
        <text class="role-tag role-tag-light" wx:else>学生</text>
      </view>
    </view>
    <view class="edit-link" bindtap="onEditProfile">编辑 ›</view>
  </view>

  <!-- 关于我们 -->
  <view class="card about-card" wx:if="{{ aboutUsBanner }}" bindtap="onAboutTap">
    <view class="about-left">
      <view class="text-h3">{{ aboutUsBanner.title }}</view>
      <view class="text-sub text-sm" style="margin-top: 6rpx;">{{ aboutUsBanner.subtitle }}</view>
    </view>
    <view class="about-arrow">›</view>
  </view>

  <!-- 收藏统计 -->
  <view class="card stat-row">
    <view class="stat-cell" bindtap="onFavTeacher">
      <view class="stat-num">{{ favoriteTeacherCount }}</view>
      <view class="text-sub text-sm">收藏老师</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-cell" bindtap="onFavCompetition">
      <view class="stat-num">{{ favoriteCompetitionCount }}</view>
      <view class="text-sub text-sm">收藏竞赛</view>
    </view>
  </view>

  <!-- 功能宫格 -->
  <view class="card grid">
    <view class="grid-cell" wx:for="{{ grid }}" wx:key="key" data-key="{{ item.key }}" bindtap="onGridTap">
      <image class="grid-icon" src="{{ item.icon }}" mode="aspectFit" />
      <view class="grid-label">{{ item.label }}</view>
    </view>
  </view>

  <!-- 驳回提醒 -->
  <view class="reject" wx:if="{{ teacher && teacher.status === 'REJECTED' && rejectReason }}">
    <text class="reject-title">⚠ 资料被驳回</text>
    <text class="reject-content">{{ rejectReason }}</text>
  </view>

  <!-- 公众号引导：根据后台 SystemConfig 渲染 -->
  <block wx:if="{{ oa }}">
    <!-- 同主体：使用原生 official-account 组件，用户可一键关注 -->
    <view class="card oa-card oa-card-native" wx:if="{{ oa.sameSubject }}">
      <official-account></official-account>
    </view>

    <!-- 非同主体：展示二维码引导（点击放大长按识别） -->
    <view class="card oa-card" wx:else bindtap="previewOaQrcode">
      <view class="oa-icon">{{ oa.name && oa.name.charAt(0) || '+' }}</view>
      <view class="oa-info">
        <view class="text-h3">{{ oa.name || '公众号' }}</view>
        <view class="text-sub text-sm">{{ oa.desc || '点击查看二维码' }}</view>
      </view>
      <image wx:if="{{ oa.qrcodeUrl }}" class="oa-qr" src="{{ oa.qrcodeUrl }}" mode="aspectFit" />
      <view wx:else class="oa-btn">关注</view>
    </view>
  </block>

  <view class="agreements">
    <text class="agree-entry" bindtap="openAgreement" data-slug="user-agreement">用户服务协议</text>
    <text class="agree-sep">·</text>
    <text class="agree-entry" bindtap="openAgreement" data-slug="privacy-policy">隐私政策</text>
  </view>

  <view class="version text-muted text-xs">v {{ appVersion }}</view>
</view>
