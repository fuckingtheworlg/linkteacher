.page { padding: 24rpx 24rpx 80rpx; min-height: 100vh; background: #f5f7fa; }
.title { font-size: 32rpx; font-weight: 700; color: #1f2937; margin-bottom: 24rpx; }

.field, .field-block {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.field { display: flex; align-items: center; gap: 16rpx; }
.label { color: #6b7280; font-size: 26rpx; }
.value { flex: 1; color: #1f2937; font-size: 28rpx; }
.arrow { color: #9ca3af; font-size: 32rpx; }

.degree-row { display: flex; gap: 16rpx; margin-top: 12rpx; flex-wrap: wrap; }
.degree-cell { padding: 14rpx 32rpx; border-radius: 8rpx; background: #f3f4f6; color: #4b5563; font-size: 26rpx; }
.degree-cell.on { background: #1f2937; color: #fff; }

.input {
  background: #f9fafb;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
}
.ph { color: #9ca3af; }

.row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }

.save {
  margin-top: 60rpx;
  background: #1f2937;
  color: #fff;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.save[disabled] { background: #9ca3af; }
.save::after { border: none; }

/* 大学 picker */
.picker-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: flex-end; }
.picker { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; max-height: 80vh; padding: 24rpx; display: flex; flex-direction: column; }
.picker-header { padding-bottom: 16rpx; }
.picker-search { background: #f3f4f6; border-radius: 32rpx; padding: 16rpx 28rpx; font-size: 28rpx; }
.picker-list { flex: 1; min-height: 60vh; }
.picker-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 12rpx; border-bottom: 1rpx solid #f3f4f6; }
.u-zh { font-size: 30rpx; color: #1f2937; font-weight: 600; }
.u-en { display: block; font-size: 24rpx; color: #6b7280; margin-top: 4rpx; }
.u-rank { color: #fbbf24; font-size: 26rpx; font-weight: 600; }
