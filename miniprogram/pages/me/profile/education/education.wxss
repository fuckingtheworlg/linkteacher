.page { padding: 24rpx 24rpx 200rpx; min-height: 100vh; background: #f5f7fa; }
.title { font-size: 36rpx; font-weight: 700; color: #1f2937; margin-bottom: 24rpx; }

.field, .field-block {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.field { display: flex; align-items: center; gap: 16rpx; }
.label { color: #6b7280; font-size: 26rpx; }
.value { flex: 1; color: #1f2937; font-size: 28rpx; }
.value:empty::before, .value.is-empty { color: #9ca3af; }
.arrow { color: #9ca3af; font-size: 36rpx; }

.degree-row { display: flex; gap: 12rpx; margin-top: 12rpx; flex-wrap: wrap; }
.degree-cell {
  padding: 14rpx 32rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 2rpx solid #f3f4f6;
  color: #4b5563;
  font-size: 26rpx;
  transition: all 0.15s;
}
.degree-cell.on { background: #1f2937; border-color: #1f2937; color: #fff; font-weight: 600; }

.input {
  background: #f9fafb;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
}
.ph { color: #9ca3af; }

.row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }

/* 大学 picker
 * 注意：iOS 小程序 input/textarea 是 native 层会穿透 wxss 弹层；
 *       wxml 已用 wx:if 把表单字段不渲染，这里 z-index 仅作保险。
 */
.picker-mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 9999;
}
.picker {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  height: 80vh;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.picker-header { padding-bottom: 16rpx; flex-shrink: 0; }
.picker-search { background: #f3f4f6; border-radius: 32rpx; padding: 16rpx 28rpx; font-size: 28rpx; }
.picker-custom {
  flex-shrink: 0;
  padding: 20rpx 12rpx;
  font-size: 26rpx;
  color: #1f2937;
  border-bottom: 1rpx solid #f3f4f6;
}
.picker-custom-name { color: #2563eb; font-weight: 600; }
.picker-list { flex: 1; min-height: 0; }
.picker-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 12rpx; border-bottom: 1rpx solid #f3f4f6; }
.u-zh { font-size: 30rpx; color: #1f2937; font-weight: 600; }
.u-en { display: block; font-size: 24rpx; color: #6b7280; margin-top: 4rpx; }
.u-rank { color: #1f2937; font-size: 24rpx; font-weight: 700; background: #fef3c7; padding: 4rpx 12rpx; border-radius: 6rpx; }
