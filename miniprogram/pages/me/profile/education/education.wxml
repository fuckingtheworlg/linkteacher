<view class="page">
  <view class="title">学历背景{{ sort + 1 }}</view>

  <view class="field" bindtap="openUniversityPicker">
    <view class="label">大学</view>
    <view class="value {{ universityName ? '' : 'is-empty' }}">{{ universityName || '点击选择' }}</view>
    <text class="arrow">›</text>
  </view>

  <view class="field-block">
    <view class="label">学位</view>
    <view class="degree-row">
      <view
        class="degree-cell {{ degree === item.code ? 'on' : '' }}"
        wx:for="{{ degreeOptions }}"
        wx:key="code"
        data-code="{{ item.code }}"
        bindtap="pickDegree"
      >{{ item.name }}</view>
    </view>
  </view>

  <view class="field-block">
    <view class="label">专业</view>
    <input class="input" value="{{ major }}" placeholder="例：生物医学" placeholder-class="ph" bindinput="onMajorInput" />
  </view>

  <view class="row-2">
    <view class="field-block">
      <view class="label">入学年份</view>
      <input class="input" type="number" value="{{ startYear }}" placeholder="2021" placeholder-class="ph" bindinput="onStartInput" />
    </view>
    <view class="field-block">
      <view class="label">毕业年份</view>
      <input class="input" type="number" value="{{ endYear }}" placeholder="2025" placeholder-class="ph" bindinput="onEndInput" />
    </view>
  </view>

  <view class="footer-bar">
    <button class="btn-primary" bindtap="onSave" disabled="{{ saving }}">
      {{ saving ? '保存中...' : '保存' }}
    </button>
  </view>
</view>
