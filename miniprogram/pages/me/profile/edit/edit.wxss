.page { padding: 24rpx 24rpx 200rpx; min-height: 100vh; background: #f5f7fa; }
.title { font-size: 36rpx; font-weight: 700; color: #1f2937; margin-bottom: 8rpx; }
.sub { color: #9ca3af; font-size: 24rpx; margin-bottom: 24rpx; }

.input, .textarea {
  background: #fff;
  border: 2rpx solid #f3f4f6;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  width: 100%;
  box-sizing: border-box;
}
.input:focus, .textarea:focus { border-color: #1f2937; }
.textarea { min-height: 320rpx; }
.ph { color: #9ca3af; }

.mbti-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.mbti-cell {
  background: #fff;
  border: 2rpx solid #f3f4f6;
  border-radius: 12rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #4b5563;
  transition: all 0.15s;
}
.mbti-cell.on {
  border-color: #1f2937;
  background: #1f2937;
  color: #fff;
  font-weight: 700;
}

.hint { color: #9ca3af; font-size: 24rpx; margin-top: 16rpx; line-height: 1.6; }
