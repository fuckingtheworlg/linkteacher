.page { padding: 24rpx; min-height: 100vh; background: #f5f7fa; }
.title { font-size: 32rpx; font-weight: 700; color: #1f2937; margin-bottom: 24rpx; }

.input, .textarea {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  width: 100%;
  box-sizing: border-box;
}
.textarea { min-height: 280rpx; }
.ph { color: #9ca3af; }

.mbti-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.mbti-cell {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #1f2937;
  border: 2rpx solid transparent;
}
.mbti-cell.on { border-color: #1f2937; color: #1f2937; font-weight: 700; }

.hint { color: #9ca3af; font-size: 24rpx; margin-top: 16rpx; }

.save {
  margin-top: 60rpx;
  background: #1f2937;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.save[disabled] { background: #9ca3af; color: #fff; }
.save::after { border: none; }
