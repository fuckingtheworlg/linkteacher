.page { padding: 24rpx 24rpx 80rpx; min-height: 100vh; background: #f5f7fa; }
.title { font-size: 32rpx; font-weight: 700; color: #1f2937; margin-bottom: 24rpx; }
.block-title { color: #4b5563; font-weight: 600; margin: 24rpx 4rpx 12rpx; }

.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.cell {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #1f2937;
  border: 2rpx solid transparent;
}
.cell.on { background: #1f2937; color: #fff; border-color: #1f2937; font-weight: 600; }

.textarea {
  background: #fff;
  width: 100%;
  box-sizing: border-box;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 200rpx;
}
.ph { color: #9ca3af; }

.save {
  margin-top: 60rpx;
  background: #1f2937;
  color: #fff;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.save[disabled] { background: #9ca3af; }
.save::after { border: none; }
