.page { padding: 24rpx 24rpx 200rpx; min-height: 100vh; background: #f5f7fa; }
.title { font-size: 36rpx; font-weight: 700; color: #1f2937; margin-bottom: 24rpx; }
.block-title { color: #6b7280; font-weight: 600; margin: 24rpx 4rpx 12rpx; font-size: 26rpx; }

.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.cell {
  background: #fff;
  border: 2rpx solid #f3f4f6;
  border-radius: 12rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #4b5563;
  transition: all 0.15s;
}
.cell.on {
  background: #1f2937;
  color: #fff;
  border-color: #1f2937;
  font-weight: 600;
}

.textarea {
  background: #fff;
  border: 2rpx solid #f3f4f6;
  width: 100%;
  box-sizing: border-box;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 200rpx;
  margin-top: 12rpx;
}
.ph { color: #9ca3af; }
