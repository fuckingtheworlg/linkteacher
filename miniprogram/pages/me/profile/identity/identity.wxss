.page { padding: 24rpx 24rpx 40rpx; background: #f5f7fa; min-height: 100vh; }

.section { margin-top: 24rpx; }
.section-title { margin: 32rpx 8rpx 12rpx; font-weight: 600; }

.row { display: flex; align-items: center; gap: 16rpx; }
.row-label { width: 160rpx; color: #6b7280; font-size: 28rpx; flex-shrink: 0; }
.row-input { flex: 1; font-size: 28rpx; color: #1f2937; }
.ph { color: #9ca3af; }

/* 身份证两面 */
.id-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}
.id-card {
  flex: 1;
  aspect-ratio: 1.6 / 1;
  background: #fff;
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.15s;
}
.id-card:active { border-color: #1f2937; background: #fafafa; }
.id-img { width: 100%; height: 100%; }
.id-reupload {
  position: absolute;
  right: 0;
  bottom: 0;
  background: rgba(31, 41, 55, 0.85);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-top-left-radius: 12rpx;
}
.id-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #9ca3af;
}
.id-placeholder .plus { font-size: 60rpx; line-height: 1; }
.id-tip { font-size: 22rpx; }

.id-note { padding: 4rpx 8rpx 24rpx; }

/* 地址定位 */
.location-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.location-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 32rpx;
  padding: 0 8rpx;
}
.agree-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.agree-check.on { background: #1f2937; border-color: #1f2937; }
.agree-text { flex: 1; font-size: 24rpx; color: #6b7280; line-height: 1.6; }
.agree-link { color: #2563eb; }

.footer-spacer { height: 140rpx; }
