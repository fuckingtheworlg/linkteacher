.page { padding: 20rpx 20rpx 40rpx; background: #f5f7fa; min-height: 100vh; }

/* 复用全局 .card / .section-title，本页只补本地差异 */
.section-title { font-size: 26rpx; color: #6b7280; margin: 24rpx 8rpx 12rpx; font-weight: 600; }
.required { color: #dc2626; margin-left: 4rpx; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 个人卡片头像 + 网格 */
.card-row { display: flex; gap: 24rpx; align-items: flex-start; }
.avatar-wrap { position: relative; width: 130rpx; height: 130rpx; flex-shrink: 0; }
.avatar { width: 130rpx; height: 130rpx; border-radius: 65rpx; background: #e5e7eb; }
.avatar.avatar-placeholder {
  display: flex; align-items: center; justify-content: center;
  color: #9ca3af; font-size: 60rpx; font-weight: 300;
}
.avatar-edit-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #1f2937;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  border: 4rpx solid #fff;
}
.grid { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }

.cell {
  background: #fff;
  border: 2rpx solid #f3f4f6;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  min-height: 92rpx;
  transition: border-color 0.15s;
}
.cell:active { border-color: #1f2937; background: #fafafa; }
.cell.wide { grid-column: span 2; }
.cell-label { font-size: 22rpx; color: #9ca3af; }
.cell-value { font-size: 28rpx; color: #1f2937; margin-top: 6rpx; word-break: break-all; }
.cell-value.strong { font-weight: 600; }
.rate-value { color: #1f2937; font-size: 32rpx; font-weight: 700; }

.kv { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }

.hint { color: #9ca3af; font-size: 22rpx; line-height: 1.7; padding: 24rpx 8rpx; }
.hint .required { color: #dc2626; }
.hint view { margin-bottom: 4rpx; }

.footer-spacer { height: 140rpx; }

.identity-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.identity-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
