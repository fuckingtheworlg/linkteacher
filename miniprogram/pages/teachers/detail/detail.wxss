.page { padding: 20rpx; padding-bottom: 200rpx; min-height: 100vh; background: #f5f7fa; }

/* 预览模式横幅 */
.preview-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #1f2937;
  color: #fff;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.preview-icon { font-size: 32rpx; }
.preview-text { display: flex; flex-direction: column; }
.preview-title { font-size: 24rpx; font-weight: 700; }
.preview-sub { font-size: 22rpx; opacity: 0.7; margin-top: 2rpx; }

/* 头部卡片 */
.card { margin-bottom: 16rpx; }
.header-card .header-row { display: flex; gap: 24rpx; align-items: center; }
.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  flex-shrink: 0;
}
.avatar.avatar-placeholder {
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; color: #9ca3af; font-weight: 300;
}

.header-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.name-line { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.gender { color: #9ca3af; font-size: 26rpx; }
.cert { color: #16a34a; font-size: 22rpx; }
.addr-line, .meta-line { display: flex; gap: 8rpx; align-items: center; flex-wrap: wrap; }

.headlines { display: flex; flex-direction: column; gap: 6rpx; }
.headline-item { color: #4b5563; }

/* 报价卡片 */
.price-card { display: flex; align-items: stretch; padding: 24rpx 0; }
.price-cell { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.price-big { color: #1f2937; font-size: 40rpx; font-weight: 700; }
.price-unit { color: #6b7280; font-size: 22rpx; font-weight: 400; margin-left: 4rpx; }
.price-divider { width: 2rpx; background: #f3f4f6; margin: 0 16rpx; }

/* 教育背景 */
.edu-list { display: flex; flex-direction: column; gap: 24rpx; }
.edu-row { display: flex; gap: 20rpx; align-items: center; }

.edu-logo-wrap {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #f3f4f6;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.edu-logo-img { width: 88rpx; height: 88rpx; }
.edu-logo-placeholder {
  font-size: 40rpx;
  font-weight: 700;
  color: #6b7280;
}

.edu-main { flex: 1; min-width: 0; }
.edu-rank-line { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.edu-name { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.edu-rank-tag {
  background: #f3f4f6;
  color: #4b5563;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.edu-name-en { margin-top: 2rpx; }
.edu-major { margin-top: 4rpx; }

/* 学历认证小圆标 */
.edu-verify {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.edu-verify-VERIFIED { background: #16a34a; color: #fff; }
.edu-verify-REJECTED { background: #dc2626; color: #fff; }
.edu-verify-PENDING  { background: #f59e0b; color: #fff; }

/* 长文本卡片：指导经验 / 工作履历 / 个人荣誉 */
.long-text {
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.7;
  color: #1f2937;
}

/* 辅导内容 */
.subject-list { display: flex; flex-direction: column; gap: 16rpx; }
.subject-row { display: flex; align-items: flex-start; gap: 16rpx; }
.subject-curri { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }

.footer-spacer { height: 60rpx; }

.loading-screen { padding: 24rpx; }
.skeleton-card { display: flex; gap: 24rpx; align-items: center; }
