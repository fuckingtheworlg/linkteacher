<view class="page" wx:if="{{ teacher }}">
  <!-- 预览模式横幅 -->
  <view class="preview-banner" wx:if="{{ isPreview }}">
    <text class="preview-icon">👁</text>
    <view class="preview-text">
      <text class="preview-title">预览模式 · 仅本人可见</text>
      <text class="preview-sub" wx:if="{{ statusText }}">{{ statusText }}</text>
    </view>
  </view>

  <!-- 头部卡片 -->
  <view class="card header-card">
    <view class="header-row">
      <image
        wx:if="{{ teacher.user.avatarUrl }}"
        class="avatar"
        src="{{ teacher.user.avatarUrl }}"
        mode="aspectFill"
      />
      <view wx:else class="avatar avatar-placeholder">{{ avatarLetter }}</view>

      <view class="header-info">
        <view class="name-line">
          <text class="text-h2">{{ nickname }}</text>
          <text class="gender" wx:if="{{ teacher.gender === 'FEMALE' }}">♀</text>
          <text class="gender" wx:if="{{ teacher.gender === 'MALE' }}">♂</text>
          <text class="cert" wx:if="{{ teacher.isCertified }}">✓ 已认证</text>
        </view>
        <view class="addr-line text-sub text-sm" wx:if="{{ teacher.country || teacher.city }}">
          {{ teacher.country }} {{ teacher.city }}
        </view>
        <view class="meta-line" wx:if="{{ tagsList.length || languagesText }}">
          <text class="tag tag-light" wx:for="{{ tagsList }}" wx:key="*this">{{ item }}</text>
          <text class="text-sub text-sm" wx:if="{{ languagesText }}">{{ languagesText }}</text>
        </view>
      </view>
    </view>

    <view class="divider" wx:if="{{ headlines.length }}"></view>
    <view class="headlines" wx:if="{{ headlines.length }}">
      <view class="headline-item text-body" wx:for="{{ headlines }}" wx:key="*this">· {{ item }}</view>
    </view>
  </view>

  <!-- 报价卡片 -->
  <view class="card price-card">
    <view class="price-cell">
      <text class="text-sub text-sm">课时费</text>
      <text class="price-big">¥{{ hourlyRateText }}<text class="price-unit">/h</text></text>
    </view>
    <view class="price-divider"></view>
    <view class="price-cell">
      <text class="text-sub text-sm">试听价</text>
      <text class="price-big">¥{{ trialRateText }}<text class="price-unit">/h</text></text>
    </view>
  </view>

  <!-- 教育背景 -->
  <view class="card" wx:if="{{ educationsView.length }}">
    <view class="section-title">教育背景</view>
    <view class="edu-list">
      <view class="edu-row" wx:for="{{ educationsView }}" wx:for-item="e" wx:key="id">
        <view class="edu-logo-wrap">
          <image wx:if="{{ e.logoUrl }}" class="edu-logo-img" src="{{ e.logoUrl }}" mode="aspectFit" />
          <view wx:else class="edu-logo-placeholder">{{ e.logoLetter }}</view>
        </view>
        <view class="edu-main">
          <view class="edu-rank-line">
            <text class="edu-name">{{ e.nameZh }}</text>
            <text class="edu-rank-tag" wx:if="{{ e.qsLabel }}">{{ e.qsLabel }}</text>
          </view>
          <view class="edu-name-en text-sub text-sm">{{ e.nameEn }}</view>
          <view class="edu-major text-sub text-sm">{{ e.degreeText }} · {{ e.major }}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 辅导内容 -->
  <view class="card" wx:if="{{ subjectsView.length }}">
    <view class="section-title">辅导内容</view>
    <view class="subject-list">
      <view class="subject-block" wx:for="{{ subjectsView }}" wx:for-item="s" wx:key="code">
        <view class="subject-row">
          <text class="tag">{{ s.name }}</text>
          <view class="subject-curri text-sub">
            <text wx:if="{{ s.igcseLine }}">{{ s.igcseLine }}</text>
            <text wx:if="{{ s.alevelLine }}">{{ s.alevelLine }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="footer-spacer"></view>

  <!-- 底部按钮 -->
  <view class="footer-bar">
    <button
      wx:if="{{ isPreview }}"
      class="btn-primary"
      bindtap="goEditProfile"
    >返回编辑资料</button>
    <button
      wx:else
      class="btn-primary"
      open-type="contact"
      session-from="teacher_detail_{{ teacherId }}"
      bindtap="onContact"
    >帮我对接老师</button>
  </view>
</view>

<view class="loading-screen" wx:elif="{{ loading }}">
  <view class="card skeleton-card">
    <view class="skeleton skeleton-circle" style="width: 140rpx; height: 140rpx;"></view>
    <view style="flex: 1; display: flex; flex-direction: column; gap: 12rpx;">
      <view class="skeleton skeleton-line" style="width: 40%;"></view>
      <view class="skeleton skeleton-line skeleton-line-sm" style="width: 80%;"></view>
      <view class="skeleton skeleton-line skeleton-line-sm" style="width: 60%;"></view>
    </view>
  </view>
</view>

<view class="empty-state" wx:else>
  <view class="empty-icon">😶</view>
  <view class="empty-title">老师不存在</view>
  <view class="empty-sub">该老师可能未上架或已下架</view>
</view>
