<view class="page" wx:if="{{ teacher }}">
  <!-- 头部 -->
  <view class="header">
    <view class="header-row">
      <image class="avatar" src="{{ teacher.user.avatarUrl }}" mode="aspectFill" />
      <view class="header-info">
        <view class="name-line">
          <text class="name">{{ teacher.user.nickname }}</text>
          <text class="gender" wx:if="{{ teacher.gender === 'FEMALE' }}">♀</text>
          <text class="gender male" wx:if="{{ teacher.gender === 'MALE' }}">♂</text>
          <text class="cert" wx:if="{{ teacher.isCertified }}">✓</text>
        </view>
        <view class="addr-line">
          <text>📍</text>
          <text wx:if="{{ teacher.country }}">{{ teacher.country }}</text>
          <text wx:if="{{ teacher.city }}">{{ teacher.city }}</text>
        </view>
      </view>
      <view class="fav" bindtap="toggleFav">
        <text wx:if="{{ favorited }}">★</text>
        <text wx:else>☆</text>
      </view>
    </view>

    <view class="headlines" wx:if="{{ headlines.length }}">
      <view class="headline-item" wx:for="{{ headlines }}" wx:key="*this">* {{ item }}</view>
    </view>

    <view class="meta-line" wx:if="{{ tagsList.length || languagesText }}">
      <text class="meta-tag" wx:for="{{ tagsList }}" wx:key="*this">{{ item }}</text>
      <text class="meta-text" wx:if="{{ languagesText }}">{{ languagesText }}</text>
    </view>

    <view class="subjects-pill-row">
      <view class="pill" wx:for="{{ subjectsView }}" wx:key="code">{{ item.name }}</view>
      <view class="price-line">
        <text class="hourly">¥{{ hourlyRateText }}/h</text>
        <text class="trial">试听半价（¥{{ trialRateText }}/h）</text>
      </view>
    </view>
  </view>

  <!-- 教育背景 -->
  <view class="section">
    <view class="section-title">教育背景</view>
    <view class="edu-list">
      <view class="edu-card" wx:for="{{ educationsView }}" wx:for-item="e" wx:key="id">
        <view class="edu-header">
          <view class="qs-rank" wx:if="{{ e.qsLabel }}">{{ e.qsLabel }}</view>
          <view class="degree-tag">{{ e.degreeText }}</view>
        </view>
        <image class="edu-logo" src="{{ e.logoUrl }}" mode="aspectFit" />
        <view class="edu-name-en">{{ e.nameEn }}</view>
        <view class="edu-name-zh">{{ e.nameZh }}</view>
        <view class="edu-major">{{ e.major }}</view>
      </view>
    </view>
  </view>

  <!-- 辅导内容 -->
  <view class="section">
    <view class="subject-blocks">
      <view class="subject-block" wx:for="{{ subjectsView }}" wx:for-item="s" wx:key="code">
        <view class="subject-pill">{{ s.name }}</view>
        <view class="subject-line" wx:if="{{ s.igcseLine }}">• {{ s.igcseLine }}</view>
        <view class="subject-line" wx:if="{{ s.alevelLine }}">• {{ s.alevelLine }}</view>
      </view>
    </view>
  </view>

  <view class="footer-spacer"></view>

  <!-- 底部对接老师按钮（客服） -->
  <view class="footer-bar">
    <button
      class="contact-btn"
      open-type="contact"
      session-from="teacher_detail_{{ teacherId }}"
      bindtap="onContact"
    >
      💬 帮我对接老师
    </button>
  </view>
</view>

<view class="loading" wx:elif="{{ loading }}">加载中...</view>
<view class="loading" wx:else>老师不存在</view>
