<view class="page" bindtap="closePanels">
  <view class="search-bar" catchtap="">
    <view class="search-input">
      <image class="icon" src="/assets/icons/search.png" mode="aspectFit" />
      <input
        type="text"
        placeholder="搜索老师 / 关键词"
        placeholder-class="ph"
        value="{{ keyword }}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
    </view>
  </view>

  <block wx:for="{{ banners }}" wx:key="id" wx:for-item="b">
    <view class="banner-card" catchtap="">
      <view class="banner-text">
        <view class="banner-sub">{{ b.subtitle }}</view>
        <view class="banner-title">{{ b.title }}</view>
      </view>
      <view class="banner-cta">查看 ›</view>
    </view>
  </block>

  <scroll-view class="subjects" scroll-x enable-flex catchtap="">
    <view
      class="subject-tab {{ activeSubjectId === 0 ? 'active' : '' }}"
      data-id="0"
      bindtap="onSubjectTap"
    >全部</view>
    <view
      wx:for="{{ subjects }}"
      wx:key="id"
      class="subject-tab {{ activeSubjectId === item.id ? 'active' : '' }}"
      data-id="{{ item.id }}"
      bindtap="onSubjectTap"
    >{{ item.name }}</view>
  </scroll-view>

  <view class="filter-bar" catchtap="">
    <view class="filter-item {{ activeCurriculumId !== 0 ? 'on' : '' }}" bindtap="toggleCurriculumPanel">
      课程体系 ▾
    </view>
    <view class="filter-item {{ sort !== 'smart' ? 'on' : '' }}" bindtap="toggleSortPanel">智能排序 ▾</view>
  </view>

  <view wx:if="{{ showCurriculumPanel }}" class="dropdown" catchtap="">
    <view
      class="dropdown-item {{ activeCurriculumId === 0 ? 'on' : '' }}"
      data-id="0"
      bindtap="onCurriculumPick"
    >全部体系</view>
    <view
      wx:for="{{ curriculums }}"
      wx:key="id"
      class="dropdown-item {{ activeCurriculumId === item.id ? 'on' : '' }}"
      data-id="{{ item.id }}"
      bindtap="onCurriculumPick"
    >{{ item.name }}</view>
  </view>

  <view wx:if="{{ showSortPanel }}" class="dropdown" catchtap="">
    <view class="dropdown-item {{ sort === 'smart' ? 'on' : '' }}" data-value="smart" bindtap="onSortPick">智能推荐</view>
    <view class="dropdown-item {{ sort === 'rate-asc' ? 'on' : '' }}" data-value="rate-asc" bindtap="onSortPick">课时费由低到高</view>
    <view class="dropdown-item {{ sort === 'rate-desc' ? 'on' : '' }}" data-value="rate-desc" bindtap="onSortPick">课时费由高到低</view>
    <view class="dropdown-item {{ sort === 'newest' ? 'on' : '' }}" data-value="newest" bindtap="onSortPick">最新上架</view>
  </view>

  <!-- 列表 -->
  <view class="list">
    <!-- 骨架屏：首次加载 -->
    <block wx:if="{{ loading && list.length === 0 }}">
      <view class="card skeleton-card" wx:for="{{ [1,2,3] }}" wx:key="*this">
        <view class="skeleton skeleton-circle" style="width: 120rpx; height: 120rpx;"></view>
        <view class="skeleton-body">
          <view class="skeleton skeleton-line" style="width: 40%;"></view>
          <view class="skeleton skeleton-line skeleton-line-sm" style="width: 70%;"></view>
          <view class="skeleton skeleton-line skeleton-line-sm" style="width: 90%;"></view>
        </view>
      </view>
    </block>

    <!-- 卡片列表 -->
    <view
      class="card teacher-card"
      wx:for="{{ list }}"
      wx:key="id"
      data-id="{{ item.id }}"
      bindtap="goDetail"
    >
      <view class="avatar-wrap">
        <image
          wx:if="{{ item.avatarUrl }}"
          class="avatar"
          src="{{ item.avatarUrl }}"
          mode="aspectFill"
          lazy-load="true"
        />
        <view wx:else class="avatar avatar-placeholder">{{ item.avatarLetter }}</view>
      </view>

      <view class="card-main">
        <view class="row1">
          <view class="row1-left">
            <text class="name">{{ item.nickname }}</text>
            <text class="gender" wx:if="{{ item.genderIcon }}">{{ item.genderIcon }}</text>
          </view>
          <view class="cert" wx:if="{{ item.isCertified }}">✓ 已认证</view>
        </view>

        <view class="meta text-sub text-sm" wx:if="{{ item.addressLine }}">{{ item.addressLine }}</view>
        <view class="meta text-sub text-sm" wx:if="{{ item.eduLine }}">{{ item.eduLine }}</view>

        <view class="tags-row" wx:if="{{ item.subjectsView.length }}">
          <view class="tag" wx:for="{{ item.subjectsView }}" wx:for-item="s" wx:key="code">{{ s.name }}</view>
        </view>

        <view class="price-row">
          <text class="price">¥{{ item.hourlyRate }}/h</text>
          <text class="price-sep">·</text>
          <text class="text-sub text-sm">试听 ¥{{ item.trialRate }}/h</text>
        </view>

        <view class="headline text-sub text-sm" wx:if="{{ item.headlineSummary }}">{{ item.headlineSummary }}</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{ !loading && list.length === 0 }}">
      <view class="empty-icon">🔍</view>
      <view class="empty-title">暂无符合条件的老师</view>
      <view class="empty-sub">试着调整筛选条件，或直接联系我们帮你匹配</view>
    </view>

    <view class="text-muted text-sm loading-tip" wx:if="{{ loading && list.length > 0 }}">加载中…</view>
    <view class="text-muted text-sm loading-tip" wx:if="{{ finished && list.length > 0 }}">— 已显示全部 —</view>
  </view>

  <!-- 帮我匹配 悬浮按钮 -->
  <button
    class="match-fab"
    open-type="contact"
    session-from="home_match_button"
    bindtap="onMatchContact"
  >帮我匹配</button>
</view>
