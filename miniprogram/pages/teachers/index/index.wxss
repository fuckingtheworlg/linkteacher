.page {
  padding: 24rpx 24rpx 160rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar { margin-bottom: 24rpx; }
.search-input {
  display: flex; align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 76rpx;
}
.search-input .icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.search-input input { flex: 1; font-size: 28rpx; color: #1f2937; }
.search-input .ph { color: #9ca3af; }

/* Banner */
.banner-card {
  background: #1f2937;
  color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.banner-sub { font-size: 22rpx; color: #d1d5db; letter-spacing: 2rpx; }
.banner-title { font-size: 30rpx; font-weight: 700; color: #fff; margin-top: 8rpx; }
.banner-cta { font-size: 24rpx; color: #d1d5db; }

/* 科目横向滚动 */
.subjects {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.subject-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 32rpx;
  background: #fff;
}
.subject-tab.active {
  background: #1f2937;
  color: #fff;
  font-weight: 600;
}

/* 二级筛选 */
.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.filter-item {
  background: #fff;
  border-radius: 8rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.filter-item.on { color: #1f2937; font-weight: 600; }

.dropdown {
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx 0;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}
.dropdown-item {
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #4b5563;
}
.dropdown-item.on { color: #1f2937; font-weight: 600; }

/* 老师卡片 */
.list { display: flex; flex-direction: column; gap: 16rpx; }
.teacher-card {
  display: flex;
  gap: 24rpx;
  align-items: stretch;
  padding: 24rpx;
}
.avatar-wrap { width: 120rpx; flex-shrink: 0; }
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
}
.avatar.avatar-placeholder {
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; color: #9ca3af; font-weight: 300;
}

.card-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.row1 { display: flex; justify-content: space-between; align-items: center; }
.row1-left { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.name { font-size: 30rpx; font-weight: 600; color: #1f2937; }
.gender { font-size: 22rpx; color: #9ca3af; }
.cert { color: #16a34a; font-size: 22rpx; flex-shrink: 0; }

.meta { color: #6b7280; }

.tags-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 4rpx; }
.tags-row .tag { background: #f3f4f6; color: #4b5563; padding: 4rpx 14rpx; font-size: 22rpx; border-radius: 6rpx; }

.price-row { display: flex; align-items: baseline; gap: 8rpx; margin-top: 4rpx; }
.price { color: #1f2937; font-weight: 700; font-size: 30rpx; }
.price-sep { color: #d1d5db; }

.headline {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 4rpx;
}

.loading-tip { text-align: center; padding: 32rpx 0; }

/* 骨架屏 */
.skeleton-card { display: flex; gap: 24rpx; }
.skeleton-body { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }

/* 帮我匹配 悬浮按钮（去黄，统一黑灰） */
.match-fab {
  position: fixed;
  right: 32rpx;
  bottom: 64rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #1f2937;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
  border: none;
  padding: 0;
}
.match-fab::after { border: none; }
