.page { padding: 32rpx 32rpx 80rpx; min-height: 100vh; background: #fff; }
.title { font-size: 40rpx; font-weight: 700; color: #1f2937; margin-bottom: 32rpx; }
.body { color: #1f2937; }
.line { font-size: 28rpx; line-height: 1.8; color: #1f2937; margin-bottom: 8rpx; }
.empty-line { height: 16rpx; }
.footer { margin-top: 48rpx; color: #9ca3af; font-size: 22rpx; text-align: right; }
.loading { padding: 200rpx 0; text-align: center; color: #9ca3af; }
